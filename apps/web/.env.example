# Template whitelabel — frontend
#
# Copie para `.env.local` (que é gitignored) e ajuste o necessário.
# Nenhuma variável aqui é obrigatória para subir em desenvolvimento: todas têm
# default no código (`src/environments.ts`). O arquivo existe para você saber o
# que EXISTE, porque um valor que você não sabe que pode mudar é um valor que
# você vai descobrir na hora errada.
#
# `NEXT_PUBLIC_*` é embutido no bundle em tempo de build e fica VISÍVEL no
# navegador. Nunca ponha segredo em variável com esse prefixo.

# ─── Integração com a API ────────────────────────────────────────────────────
# URL base da API, com o prefixo /api. É a única variável que você
# provavelmente precisa mexer: se o backend não estiver na 3001, ajuste aqui.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Origem do servidor (sem o /api) — usada por WebSocket e por links absolutos.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Hosts HTTPS liberados pro otimizador de imagem do Next (logo/avatar
# externos). Vazio em produção = nenhum host externo passa pelo /_next/image
# (fail-safe — sem isso, o otimizador aceitava QUALQUER host HTTPS, virando
# proxy de imagem aberto). Em dev, vazio libera qualquer host, por
# conveniência. Não é NEXT_PUBLIC: só o build/servidor Next lê.
# IMAGE_ALLOWED_HOSTS=cdn.suaempresa.com,meu-bucket.s3.amazonaws.com

# ─── Identidade da aplicação ─────────────────────────────────────────────────
# Alimentam o branding na interface e os metadados das páginas.
NEXT_PUBLIC_APP_NAME=Mutirão Mamografia
NEXT_PUBLIC_APP_DESCRIPTION=Sistema de agendamento do Mutirão de Mamografia 2026.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_AUTHOR=
NEXT_PUBLIC_EMAIL_SUPPORT=suporte@example.com

# ─── Chaves de terceiros ─────────────────────────────────────────────────────
# Deixe VAZIAS aqui. Preencha só no seu `.env.local`, e nunca comite valor real.
#
# Google Maps: usada apenas onde há mapa. Sem ela, a feature degrada; o resto do
# app funciona. Atenção ao prefixo NEXT_PUBLIC: esta chave FICA EXPOSTA no
# navegador, então restrinja o uso dela por domínio no console do Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
