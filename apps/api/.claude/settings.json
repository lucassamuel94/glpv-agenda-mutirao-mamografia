{
  "permissions": {
    "allow": [
      "Bash(npm run start:dev)",
      "Bash(npm run start)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint:check)",
      "Bash(npm run lint:fix)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:cov)",
      "Bash(npm run test:e2e)",
      "Bash(npm run check)",
      "Bash(npm run seed:*)",
      "Bash(npm run db:*)",
      "Bash(npx nest:*)",
      "Bash(npx ts-node:*)",
      "Bash(npx jest:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/block-provider-redeclaration.sh", "timeout": 10 },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/warn-raw-queries.sh", "timeout": 10 },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/warn-raw-cache-keys.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
