{
  "name": "@ez-starter-kit/api",
  "version": "1.0.0",
  "description": "Backend do template whitelabel de CRM All-in-One",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "prebuild": "npm run lint:check",
    "dev": "TZ=UTC nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "TZ=UTC nest start",
    "start:dev": "TZ=UTC nest start --watch",
    "start:debug": "TZ=UTC nest start --debug --watch",
    "start:prod": "TZ=UTC node build/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:strict": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "test": "TZ=UTC jest",
    "test:watch": "TZ=UTC jest --watch",
    "test:cov": "TZ=UTC jest --coverage",
    "test:debug": "TZ=UTC node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed:admin": "TZ=UTC ts-node --transpile-only scripts/seed-admin.ts",
    "seed:clinics": "TZ=UTC ts-node --transpile-only scripts/seed-clinics.ts",
    "load:slots": "TZ=UTC ts-node --transpile-only scripts/load-slots.ts",
    "db:recreate": "TZ=UTC ts-node --transpile-only scripts/recreate-dev-db.ts",
    "db:rls:apply": "TZ=UTC ts-node --transpile-only scripts/apply-rls-only.ts",
    "db:migrate:platform-tenant": "TZ=UTC ts-node --transpile-only scripts/migrate-platform-tenant.ts",
    "typeorm": "TZ=UTC ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "TZ=UTC ts-node --transpile-only scripts/migration-run.ts",
    "migration:revert": "TZ=UTC ts-node --transpile-only scripts/migration-revert.ts",
    "migration:run:prod": "node scripts/migrate-prod.js",
    "test:integration": "TZ=UTC jest --config jest.integration.json",
    "db:test-role": "TZ=UTC psql \"postgresql://${DB_USERNAME:-ezcrm}:${DB_PASSWORD:-ezcrmpassword}@${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_DATABASE:-glpv-agenda-mutirao-mamografia}\" -f src/database/rls/test-role.sql",
    "check": "npm run lint:check && npm run test",
    "check:ci": "npm run lint:strict && npm run test:cov",
    "install:fresh": "npm run db:recreate"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.0.0",
    "@types/google.maps": "^3.58.1",
    "bcrypt": "^6.0.0",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "helmet": "^8.3.0",
    "nestjs-cls": "^6.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.0",
    "typeorm": "^0.3.25",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cache-manager": "^5.0.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "\\.integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
