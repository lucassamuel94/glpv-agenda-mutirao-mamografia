# Backend — template/boilerplate
#
# Copie para `.env` (gitignored) e ajuste. Este arquivo lista TUDO o que o
# código realmente lê — nada aqui é decorativo, e variável que o código não lê
# não está aqui. Se você adicionar uma leitura nova de `process.env`/
# `ConfigService`, registre-a neste arquivo na mesma mudança.

# ─── Identidade da aplicação (whitelabel) ───────────────────────────────────
# Nome exibido no Swagger e nos logs de boot. Projeto-filho: troque pelo nome
# do seu produto.
APP_NAME=EZ Starter Kit

# Nome do projeto Docker Compose (docker/docker-compose.yml) — prefixa volume,
# rede e nomes de container. Projeto-filho: troque para não colidir com o
# template ao rodar os dois ao mesmo tempo na mesma máquina.
COMPOSE_PROJECT_NAME=app

# ─── Banco de dados (obrigatório) ───────────────────────────────────────────
# Os valores abaixo batem com o `docker/docker-compose.yml` deste repositório
# (mesmas variáveis DB_USERNAME/DB_PASSWORD/DB_DATABASE alimentam os dois).
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app
DB_DATABASE=app

# ─── Redis (obrigatório para cache distribuído; sem ele cai em memória) ─────
# Sem senha, deixe VAZIO. Nunca escreva a string "null" — ela seria enviada
# como senha literal num AUTH para um servidor que não pede senha.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origem liberada no CORS — a URL onde o frontend roda.
FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Em desenvolvimento pode ficar vazio (há um fallback de dev). Em PRODUÇÃO é
# OBRIGATÓRIO: o boot recusa subir sem ele (ver src/auth/jwt-secret.ts).
# Gere um valor forte: `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Fuso horário ────────────────────────────────────────────────────────────
# ATENÇÃO: são DUAS coisas diferentes, e a distinção importa.
#
# O fuso de ARMAZENAMENTO é UTC e NÃO é configurável por aqui: vem do prefixo
# `TZ=UTC` nos scripts do package.json (o porquê está documentado no topo de
# src/main.ts — fora de UTC, colunas de instante divergem 3h entre as origens
# de tempo, e há um spec de integração que fica vermelho).
#
# TIMEZONE é só o fuso de EXIBIÇÃO usado pelo date-formatter ao apresentar
# datas para humanos.
TIMEZONE=America/Sao_Paulo

# ─── Produção: primeiro deploy ───────────────────────────────────────────────
# Em produção o schema NÃO é sincronizado no boot — sem exceção, sem flag de
# escape. Schema (tabelas, índices, RLS) vem de migrations versionadas em
# `src/database/migrations/`. Rode, como passo de DEPLOY (antes de subir a
# aplicação, nunca dentro do processo dela):
#   npm run migration:run:prod
# (usa o build compilado em `build/`, sem depender de ts-node/typescript —
# ver `scripts/migrate-prod.js`. Em dev, `npm run migration:run`.)
#
# O banco fica sem usuário nenhum — de propósito. O primeiro administrador é
# criado por quem instalou, na tela `/setup` do frontend (ver README, seções
# "Primeiro acesso" e "Deploy em produção"). Não rode seeds em produção.
#
# ATENÇÃO — DB_USERNAME em produção NÃO pode ser um role superuser nem com
# BYPASSRLS. O `docker/docker-compose.yml` deste repo faz `POSTGRES_USER` virar
# superuser automaticamente (comportamento padrão da imagem oficial do
# Postgres) — ótimo pra dev, INSEGURO em produção: com esse role, o Postgres
# ignora TODAS as policies de RLS (isolamento entre organizações clientes),
# mesmo com elas aplicadas corretamente. Em produção, crie um role restrito
# (ver o padrão em `src/database/rls/test-role.sql`: LOGIN + NOSUPERUSER
# NOBYPASSRLS + GRANT explícito nas tabelas) e aponte DB_USERNAME pra ele. O
# boot (`RlsVerifierService`) recusa subir em NODE_ENV=production se detectar
# superuser/BYPASSRLS na conexão.

# Em produção o SSL das conexões Postgres liga por padrão. Se o Postgres está
# sem TLS (docker/rede privada — caso comum, inclusive no docker/ deste
# repo), isso trava o boot em retry eterno ("The server does not support SSL
# connections"). Nesse caso, defina explicitamente:
# DB_SSL=false

# ─── Opcionais: ajuste fino (todas têm default sensato no código) ────────────
# DB_POOL_MAX=10                 # conexões máximas do pool
# DB_STATEMENT_TIMEOUT_MS=30000  # timeout de statement no Postgres
# REDIS_DB=0
#
# Réplicas de leitura (se ausentes, caem no DB_HOST principal):
# DB_DASHBOARDS_HOST=            # conexão "dashboards"
# DB_DASHBOARDS_PORT=
# DB_REPORTS_HOST=               # conexão "reports"
# DB_REPORTS_PORT=
#
# TTLs de cache por entidade, em segundos (defaults em cache.constants.ts):
# CONTACT_ITEM_CACHE_TTL= / CONTACT_LIST_CACHE_TTL=
# COMPANY_ITEM_CACHE_TTL= / COMPANY_LIST_CACHE_TTL=
# DEAL_ITEM_CACHE_TTL= / DEAL_LIST_CACHE_TTL=
# INTERACTION_ITEM_CACHE_TTL= / INTERACTION_LIST_CACHE_TTL=
# TASK_ITEM_CACHE_TTL= / TASK_LIST_CACHE_TTL=
# USER_ITEM_CACHE_TTL= / USER_PROFILE_CACHE_TTL= / AUTH_SESSION_CACHE_TTL=

